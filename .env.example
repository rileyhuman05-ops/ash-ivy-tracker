# Primary account (Riley.Human) — set via Cursor Secrets, never commit values.
WAREHOUSE_USERNAME=
WAREHOUSE_PASSWORD=

# Second account (Nexstar2026) — set via Cursor Secrets.
# If WAREHOUSE_USERNAME_2 is omitted but WAREHOUSE_PASSWORD_2 is set,
# the app uses username Nexstar2026 automatically.
WAREHOUSE_USERNAME_2=
WAREHOUSE_PASSWORD_2=

# Optional extra users as JSON array (advanced):
# WAREHOUSE_USERS=[{"username":"Other","password":"..."}]

# Local smoke only: if no secrets are set, npm run dev accepts preview / preview.
# Hosted/production never uses that placeholder.
