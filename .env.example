# Supabase (server-only). Set via Cursor Secrets — never commit values.
# SUPABASE_URL must be https://YOUR_PROJECT_REF.supabase.co (no trailing slash).
# SUPABASE_SERVICE_ROLE_KEY must be the long JWT from Supabase → Project Settings → API
# (service_role). Pasting the project URL or a short token here causes 401 and empty saves.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
